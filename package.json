{
  "name": "volt-environment",
  "private": true,
  "version": "1.0.0",
  "description": "Volt - A browser-based development operating environment engineered around Windows CMD (70%), VS Code modal editor (20%), and Chrome file tabs (10%). Local-first with zero backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.singlefile.config.ts && python3 postbuild-singlefile.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json,md}'",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:root": "npm run build && cp Volt-Double-Click.html index.html"
  },
  "dependencies": {
    "monaco-editor": "^0.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^5.3.2",
    "vite-plugin-singlefile": "^2.0.1",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
